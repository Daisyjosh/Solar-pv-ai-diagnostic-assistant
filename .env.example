# ==============================================================================
# Solar PV AI Diagnostic Assistant - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development. Never commit '.env' to git.
# All values below are safe development defaults. No real credentials required.

# --- Application Settings ---
APP_NAME="Solar PV AI Diagnostic Assistant"
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=dev-insecure-secret-key-change-in-production

# --- API Service ---
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# --- Frontend Service (Streamlit) ---
FRONTEND_PORT=8501
BACKEND_API_URL=http://127.0.0.1:8000/api/v1

# --- Database Configuration ---
DATABASE_URL=sqlite:///./data/solar_pv_diagnostics.db

# --- Storage & File Handling ---
STORAGE_DIR=./data
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_EXTENSIONS=["jpg","jpeg","png","tif","tiff"]

# --- Diagnostic & Inspection Defaults ---
MIN_IRRADIANCE_THRESHOLD_W_M2=600.0

# --- LLM & Vision Service Options ---
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash
